{
  "rewrites": [
    {
      "source": "/order",
      "destination": "/order.html"
    }
  ],
  "redirects": [
    {
      "source": "/go/2",
      "destination": "http://thegutsave.com/start/index.php?aff_id=4246",
      "permanent": false
    },
    {
      "source": "/go/3",
      "destination": "http://thegutsave.com/start/index.php?aff_id=4246",
      "permanent": false
    },
    {
      "source": "/go/6",
      "destination": "http://thegutsave.com/start/index.php?aff_id=4246",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/go/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/order",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/key.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}